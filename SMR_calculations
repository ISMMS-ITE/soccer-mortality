    ),

    interval_end = list(
      tail(split_points, -1)
    )
  ) %>%
  ungroup() %>%
  select(-split_points) %>%
  unnest(c(interval_start, interval_end)) %>%
  mutate(
    interval_days =
      as.numeric(interval_end - interval_start)
  )
```

# assign each interval to age group and calendar year 
```{r}

covid_split <- covid_split %>%
  mutate(
    birthday_this_year = as.Date(
      if_else(
        format(DOB, "%m-%d") == "02-29" &
          !leap_year(year(interval_start)),

        paste0(year(interval_start), "-02-28"),

        paste0(
          year(interval_start), "-",
          format(DOB, "%m-%d")
        )
      )
    ),

    age_at_start =
      year(interval_start) - year(DOB) -
      if_else(
        interval_start < birthday_this_year,
        1L,
        0L
      ),

    agecat = cut(
      age_at_start,
      breaks = age_breaks,
      labels = age_labels,
      right = FALSE
    ),

    agecat =
      as.numeric(as.character(agecat)),

    calendar =
      year(interval_start)
  )
```

# aggregate person time by age x year
```{r}
covid_strata <- covid_split %>%
  mutate(
    interval_py = interval_days / 365
  ) %>%
  group_by(agecat, calendar) %>%
  summarise(
    cohort_person_years = sum(interval_py),
    n_intervals = n(),
    .groups = "drop"
  ) %>%
  arrange(agecat, calendar)

# QC
covid_strata %>%
  summarise(
    n_strata_with_time = n(),
    total_person_years = sum(cohort_person_years),
    min_person_years = min(cohort_person_years),
    max_person_years = max(cohort_person_years)
  )

anti_join(
  covid_strata,
  covid_ref %>% select(agecat, calendar),
  by = c("agecat", "calendar")
)
```

# apply the italian covid mortality rates 
```{r}
covid_smr_data <- covid_ref %>%
  select(
    agecat,
    calendar,
    ref_deaths = perioddeaths,
    ref_person_years = periodpys
  ) %>%
  left_join(
    covid_strata %>%
      select(
        agecat,
        calendar,
        cohort_person_years
      ),
    by = c("agecat", "calendar")
  ) %>%
  mutate(
    cohort_person_years =
      coalesce(cohort_person_years, 0),

    ref_mortality_rate =
      ref_deaths / ref_person_years,

    expected_deaths =
      cohort_person_years * ref_mortality_rate
  ) %>%
  arrange(agecat, calendar)

# QC
covid_smr_data %>%
  summarise(
    n_reference_strata = n(),
    n_strata_with_cohort_time =
      sum(cohort_person_years > 0),
    missing_ref_deaths =
      sum(is.na(ref_deaths)),
    missing_ref_person_years =
      sum(is.na(ref_person_years)),
    total_cohort_person_years =
      sum(cohort_person_years),
    total_expected_deaths =
      sum(expected_deaths)
  )
```


    age_at_last_day =
      year(interval_last_day) - year(DOB) -
      if_else(
        interval_last_day < birthday_last_day_year,
        1L,
        0L
      ),

    agecat_last_day = cut(
      age_at_last_day,
      breaks = age_breaks,
      labels = age_labels,
      right = FALSE
    ),

    calendar_last_day = cut(
      interval_last_day,
      breaks = calendar_breaks,
      labels = calendar_labels,
      right = FALSE
    ),

    agecat_last_day =

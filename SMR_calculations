```{r}
# full follow up cohort 


# 1. Expected cardiovascular deaths using NEW rebuilt person-time


cardio_age_expected <- cardio_smr_data %>%
  mutate(
    age_group = case_when(
      agecat <= 34 ~ "15-34",
      agecat <= 54 ~ "35-54",
      agecat <= 74 ~ "55-74",
      agecat >= 75 ~ "75+",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(!is.na(age_group)) %>%
  group_by(age_group) %>%
  summarise(
    person_years = sum(cohort_person_years, na.rm = TRUE),
    expected_deaths = sum(expected_deaths, na.rm = TRUE),
    .groups = "drop"
  )


# 2. Observed cardiovascular deaths by age group


cardio_age_observed <- cardio_cohort_old %>%
  mutate(
    agecat = as.numeric(agecat),

    age_group = case_when(
      agecat <= 34 ~ "15-34",
      agecat <= 54 ~ "35-54",
      agecat <= 74 ~ "55-74",
      agecat >= 75 ~ "75+",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(!is.na(age_group)) %>%
  group_by(age_group) %>%
  summarise(
    observed_deaths = sum(perioddeaths, na.rm = TRUE),
    .groups = "drop"
  )


# 3. Calculate age-specific SMRs and exact Poisson 95% CIs


cardio_age_smr <- cardio_age_expected %>%
  left_join(
    cardio_age_observed,
    by = "age_group"
  ) %>%
  mutate(
    observed_deaths = coalesce(observed_deaths, 0)
  ) %>%
  rowwise() %>%
  mutate(
    poisson_result = list(
      poisson.test(
        observed_deaths,
        T = expected_deaths,
        r = 1
      )
    ),

    SMR = observed_deaths / expected_deaths,

    lower_95_CI =
      poisson_result$conf.int[1],

    upper_95_CI =
      poisson_result$conf.int[2],

    p_value =
      poisson_result$p.value
  ) %>%
  ungroup() %>%
  select(-poisson_result) %>%
  mutate(
    age_group = factor(
      age_group,
      levels = c(
        "15-34",
        "35-54",
        "55-74",
        "75+"
      )
    )
  ) %>%
  arrange(age_group)


# View the newly calculated values
cardio_age_smr %>%
  print(width = Inf)

# 4. Plot

ggplot(
  cardio_age_smr,
  aes(
    x = age_group,
    y = SMR
  )
) +
  geom_hline(
    yintercept = 1,
    color = "red",
    linewidth = 1
  ) +
  geom_errorbar(
    aes(
      ymin = lower_95_CI,
      ymax = upper_95_CI
    ),

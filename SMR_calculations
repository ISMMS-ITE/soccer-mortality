# split the new follow up exactly 
```{r}
career_split <- career_fu %>%
  filter(!is.na(career_smr_start)) %>%
  rowwise() %>%
  mutate(
    split_points = list(
      make_split_points(
        DOB,
        career_smr_start,
        analysis_end
      )
    ),

    interval_start = list(
      head(split_points, -1)
    ),

    interval_end = list(
      tail(split_points, -1)
    )
  ) %>%
  ungroup() %>%
  select(-split_points) %>%
  unnest(c(interval_start, interval_end)) %>%
  mutate(
    interval_days =
      as.numeric(interval_end - interval_start)
  )

# QC
career_split %>%
  summarise(
    n_intervals = n(),
    missing_interval_start = sum(is.na(interval_start)),
    missing_interval_end = sum(is.na(interval_end)),
    nonpositive_intervals =
      sum(interval_days <= 0, na.rm = TRUE),
    total_split_person_years =
      sum(interval_days / 365)
  ) %>%
  print(width = Inf)
```

# assign age and calendar strata 
```{r}
career_split <- career_split %>%
  mutate(
    # Birthday in the year of interval start
    birthday_this_year = as.Date(
      if_else(
        format(DOB, "%m-%d") == "02-29" &
          !leap_year(year(interval_start)),

        paste0(year(interval_start), "-02-28"),

        paste0(
          year(interval_start), "-",
          format(DOB, "%m-%d")
        )
      )
    ),

    # Attained age at interval start
    age_at_start =
      year(interval_start) - year(DOB) -
      if_else(
        interval_start < birthday_this_year,
        1L,
        0L
      ),

    # Age stratum
    agecat = cut(
      age_at_start,
      breaks = age_breaks,
      labels = age_labels,
      right = FALSE
    ),

    # Calendar stratum
    calendar = cut(
      interval_start,
      breaks = calendar_breaks,
      labels = calendar_labels,
      right = FALSE
    ),

    agecat = as.numeric(as.character(agecat)),
    calendar = as.numeric(as.character(calendar))
  )

career_split %>%
  summarise(
    n_intervals = n(),
    missing_agecat = sum(is.na(agecat)),
    missing_calendar = sum(is.na(calendar)),
    min_age = min(age_at_start, na.rm = TRUE),
    max_age = max(age_at_start, na.rm = TRUE),
    n_age_groups = n_distinct(agecat),
    n_calendar_groups = n_distinct(calendar)
  ) %>%
  print(width = Inf)
```

# verify no interval crosses a stratum 
```{r}
career_split <- career_split %>%

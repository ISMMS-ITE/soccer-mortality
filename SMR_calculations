# 1. all COD, players with full follow up 

--------------------------------------------

```{r}
# Calculate all-cause SMR

observed_deaths <- sum(full_fu$smr_death)

expected_deaths <- sum(smr_data$expected_deaths)

smr <- observed_deaths / expected_deaths

# Exact Poisson 95% CI and p-value
poisson_result <- poisson.test(
  observed_deaths,
  T = expected_deaths,
  r = 1
)

all_cause_smr_results <- tibble(
  n_players = nrow(full_fu),
  observed_deaths = observed_deaths,
  person_years = sum(smr_data$cohort_person_years),
  expected_deaths = expected_deaths,
  SMR = smr,
  lower_95_CI = poisson_result$conf.int[1],
  upper_95_CI = poisson_result$conf.int[2],
  p_value = poisson_result$p.value
)

all_cause_smr_results
```



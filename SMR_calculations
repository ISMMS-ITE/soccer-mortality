# split the follow up at age group and year boundaries 
```{r}

covid_calendar_breaks <- as.Date(c(
  "2020-01-01",
  "2021-01-01",
  "2022-01-01"
))

make_covid_split_points <- function(dob, start_date, end_date) {

  # Birthdays where a new 5-year age category begins
  cut_ages <- seq(20, 90, by = 5)
  target_years <- year(dob) + cut_ages

  # Construct age-boundary dates
  if (format(dob, "%m-%d") == "02-29") {

    age_cut_dates <- as.Date(
      ifelse(
        leap_year(target_years),
        paste0(target_years, "-02-29"),
        paste0(target_years, "-02-28")
      )
    )

  } else {

    age_cut_dates <- as.Date(
      paste0(
        target_years,
        "-",
        format(dob, "%m-%d")
      )
    )
  }

  age_cut_dates <- age_cut_dates[
    age_cut_dates > start_date &
      age_cut_dates < end_date
  ]

  calendar_cut_dates <- covid_calendar_breaks[
    covid_calendar_breaks > start_date &
      covid_calendar_breaks < end_date
  ]

  sort(
    unique(
      c(
        start_date,
        age_cut_dates,
        calendar_cut_dates,
        end_date
      )
    )
  )
}



# multivariable models
```{r}
# ============================================================
# MULTIVARIABLE COX PROPORTIONAL HAZARDS MODELS
# Survival time measured FROM BIRTH
# ============================================================

library(lubridate)

# Add age/year at beginning of professional career
analysis_complete <- analysis_complete %>%
  mutate(
    # Beginning of professional career
    # defined as June 15 of esordio year
    career_start_date = as.Date(
      paste0(esordio, "-06-15")
    ),

    # Year professional career began
    career_start_year = esordio,

    # Age at beginning of professional career
    age_start_career =
      as.numeric(career_start_date - DOB) / 365.25
  )


# ------------------------------------------------------------
# QC
# ------------------------------------------------------------

analysis_complete %>%
  summarise(
    n = n(),
    deaths = sum(death, na.rm = TRUE),

    missing_BMI = sum(is.na(BMI)),
    missing_position = sum(is.na(position_clean)),
    missing_age_start_career = sum(is.na(age_start_career)),
    missing_career_start_year = sum(is.na(career_start_year)),
    missing_games_50 = sum(is.na(games_50)),
    missing_CareerLength = sum(is.na(CareerLength)),

    min_age_start_career =
      min(age_start_career, na.rm = TRUE),

    max_age_start_career =
      max(age_start_career, na.rm = TRUE),

    min_career_start_year =
      min(career_start_year, na.rm = TRUE),

    max_career_start_year =
      max(career_start_year, na.rm = TRUE)
  ) %>%
  print(width = Inf)


# ============================================================
# MODEL 1
# BMI + position + age at beginning of career +
# year beginning career + games played per 50
# ============================================================

cox_multi_1 <- coxph(
  Surv(followup_years_birth, death) ~
    BMI +
    position_clean +
    age_start_career +
    career_start_year +
    games_50,
  data = analysis_complete
)

summary(cox_multi_1)


# ============================================================
# MODEL 2
# BMI + position + age at beginning of career +
# year beginning career + career length
# ============================================================

cox_multi_2 <- coxph(
  Surv(followup_years_birth, death) ~
    BMI +
    position_clean +
    age_start_career +
    career_start_year +
    CareerLength,
  data = analysis_complete
)

summary(cox_multi_2)


# ------------------------------------------------------------
# Proportional hazards assumption
# ------------------------------------------------------------

cox.zph(cox_multi_1)
cox.zph(cox_multi_2)


# ------------------------------------------------------------
# Publication-style table: Model 1
# ------------------------------------------------------------

tbl_multi_1 <- tbl_regression(
  cox_multi_1,
  exponentiate = TRUE,
  label = list(
    BMI ~ "BMI (kg/m²)",
    position_clean ~ "Position",
    age_start_career ~ "Age at beginning of career (years)",
    career_start_year ~ "Year of beginning of career",
    games_50 ~ "No. of official games played (per 50 games)"
  )
) %>%
  add_global_p(
    include = position_clean
  ) %>%
  modify_table_body(
    ~ .x %>%
      mutate(
        label = if_else(
          label == "Forward",
          "Forward (Reference)",
          label
        )
      )
  ) %>%
  modify_header(
    label ~ "**Variable**",
    estimate ~ "**Hazard Ratio**",
    conf.low ~ "**95% CI**",
    p.value ~ "**P-value**"
  )


tbl_multi_2 <- tbl_regression(
  cox_multi_2,
  exponentiate = TRUE,
  label = list(
    BMI ~ "BMI (kg/m²)",
    position_clean ~ "Position",
    age_start_career ~ "Age at beginning of career (years)",
    career_start_year ~ "Year of beginning of career",
    CareerLength ~ "Length of career (years)"
  )
) %>%
  add_global_p(
    include = position_clean
  ) %>%
  modify_table_body(
    ~ .x %>%
      mutate(
        label = if_else(
          label == "Forward",
          "Forward (Reference)",
          label
        )
      )
  ) %>%
  modify_header(
    label ~ "**Variable**",
    estimate ~ "**Hazard Ratio**",
    conf.low ~ "**95% CI**",
    p.value ~ "**P-value**"
  )


# View tables
tbl_multi_1
tbl_multi_2


# ------------------------------------------------------------
# Combine Model 1 and Model 2 side-by-side
# ------------------------------------------------------------

tbl_multivariable_combined <- tbl_merge(
  tbls = list(
    tbl_multi_1,
    tbl_multi_2
  ),
  tab_spanner = c(
    "**Model 1: Total games**",
    "**Model 2: Career length**"
  )
)

tbl_multivariable_combined
```


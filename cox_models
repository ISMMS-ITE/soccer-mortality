Conducting univariable and multivariable cox models for survival 

```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)
```

```{r}
library(haven)
library(dplyr)
library(survival)
library(gtsummary)
library(officer)
library(flextable)
```

```{r}
retro_update6 <- read_sas(
  "sas_datafiles/retro_update6.sas7bdat"
)

```

```{r}
admin_end <- as.Date("2023-12-31")

analysis_complete <- retro_update6 %>%
  filter(vitalstatus %in% c(0, 1)) %>%
  mutate(
    # End of follow-up, defined consistently with the SMR analysis
followup_end = pmin(
  coalesce(DOD, admin_end),
  LastFU,
  admin_end,
  na.rm = TRUE
),

# Survival time from birth to end of follow-up
followup_years_birth =
  as.numeric(followup_end - DOB) / 365,


# count a death as an event only if it occurred during observed follow-up
death = if_else(
  vitalstatus == 1 &
    !is.na(DOD) &
    DOD == followup_end,
  1,
  0
),

    # BMI = kg / m^2
    BMI = peso_medio / (altezza_media / 100)^2,

# Number of official games, scaled per 50 games
games_50 = presenze_totali / 50,

    # Recode position labels
    position_clean = case_when(
      position == "" | is.na(position) ~ NA_character_,
      grepl("^forw", position, ignore.case = TRUE) ~ "Forward",
      grepl("^mid", position, ignore.case = TRUE) ~ "Midfielder",
      grepl("^def", position, ignore.case = TRUE) ~ "Defender",
      grepl("^goal", position, ignore.case = TRUE) ~ "Goalkeeper",
      grepl("^multi", position, ignore.case = TRUE) ~ "Multi role",
      TRUE ~ position
    ),

    # Forward as reference category, matching Matt's table
    position_clean = factor(
      position_clean,
      levels = c(
        "Forward",
        "Midfielder",
        "Defender",
        "Goalkeeper",
        "Multi role"
      )
    )
  )

# QC before modeling
analysis_complete %>%
  summarise(
    n = n(),
    deaths = sum(death),

    missing_DOB = sum(is.na(DOB)),
    missing_followup_end = sum(is.na(followup_end)),
    missing_followup = sum(is.na(followup_years_birth)),

    negative_followup =
      sum(followup_years_birth < 0, na.rm = TRUE),

    followup_after_admin_end =
      sum(followup_end > admin_end, na.rm = TRUE),

    deaths_end_not_DOD =
      sum(
        vitalstatus == 1 &
          followup_end != DOD,
        na.rm = TRUE
      ),

    negative_career_length =
      sum(CareerLength < 0, na.rm = TRUE),

    missing_BMI = sum(is.na(BMI)),
    missing_career = sum(is.na(CareerLength)),
    missing_games = sum(is.na(presenze_totali)),
    missing_position = sum(is.na(position_clean))
  ) %>%
  print(width = Inf)
```

# univaribale cox models 
```{r}
# Univariable Cox proportional hazards models

# BMI
cox_bmi <- coxph(
  Surv(followup_years_birth, death) ~ BMI,
  data = analysis_complete
)

# Length of professional career
cox_career <- coxph(
  Surv(followup_years_birth, death) ~ CareerLength,
  data = analysis_complete
)

# Number of official games played
cox_games <- coxph(
  Surv(followup_years_birth, death) ~ games_50,
  data = analysis_complete
)

# Position
cox_position <- coxph(
  Surv(followup_years_birth, death) ~ position_clean,
  data = analysis_complete
)


# View model results
summary(cox_bmi)
summary(cox_career)
summary(cox_games)
summary(cox_position)

# Check proportional hazards assumption
cox.zph(cox_bmi)
cox.zph(cox_career)
cox.zph(cox_games)
cox.zph(cox_position)


# multivariable cox models
```{r}
library(lubridate)

# Add age/year at beginning of professional career
analysis_complete <- analysis_complete %>%
  mutate(
    # Beginning of professional career
    # defined as June 15 of esordio year
    career_start_date = as.Date(
      paste0(esordio, "-06-15")
    ),

    # Year professional career began
    career_start_year = esordio,

    # Age at beginning of professional career
    age_start_career =
      as.numeric(career_start_date - DOB) / 365.25
  )

# QC

analysis_complete %>%
  summarise(
    n = n(),
    deaths = sum(death, na.rm = TRUE),

    missing_BMI = sum(is.na(BMI)),
    missing_position = sum(is.na(position_clean)),
    missing_age_start_career = sum(is.na(age_start_career)),
    missing_career_start_year = sum(is.na(career_start_year)),
    missing_games_50 = sum(is.na(games_50)),
    missing_CareerLength = sum(is.na(CareerLength)),

    min_age_start_career =
      min(age_start_career, na.rm = TRUE),

    max_age_start_career =
      max(age_start_career, na.rm = TRUE),

    min_career_start_year =
      min(career_start_year, na.rm = TRUE),

    max_career_start_year =
      max(career_start_year, na.rm = TRUE)
  ) %>%
  print(width = Inf)


# MODEL 1
# BMI + position + age at beginning of career +
# year beginning career + games played per 50


cox_multi_1 <- coxph(
  Surv(followup_years_birth, death) ~
    BMI +
    position_clean +
    age_start_career +
    career_start_year +
    games_50,
  data = analysis_complete
)

summary(cox_multi_1)


# MODEL 2
# BMI + position + age at beginning of career +
# year beginning career + career length

cox_multi_2 <- coxph(
  Surv(followup_years_birth, death) ~
    BMI +
    position_clean +
    age_start_career +
    career_start_year +
    CareerLength,
  data = analysis_complete
)

summary(cox_multi_2)


# Proportional hazards assumption

cox.zph(cox_multi_1)
cox.zph(cox_multi_2)
```
